{
  "info": {
    "name": "Test-API — QA Workshop",
    "_postman_id": "b1e4a1d0-qa-workshop-collection",
    "description": "Ready-to-run Postman collection for the QA Automation Workshop Test-API. Every request is annotated with the concept it teaches. Use the paired environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": null,
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: ensure baseUrl is set.",
          "if (!pm.environment.get('baseUrl')) {",
          "  pm.environment.set('baseUrl', 'http://127.0.0.1:8000');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level tests that run for every request.",
          "pm.test('Content-Type is application/json', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "});",
          "pm.test('Response time is below 1000 ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Smoke: Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/healthcheck", "host": ["{{baseUrl}}"], "path": ["healthcheck"] },
        "description": "Positive: liveness probe. Learn how to assert status codes and JSON structure."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Body is an array', () => pm.expect(body).to.be.an('array').with.lengthOf(1));",
              "pm.test('Reports Healthy', () => pm.expect(body[0].status).to.eql('Healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Positive: POST /keys (single)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": {{keyId}}, \"Data\": \"BRUCE WAYNE\", \"DataType\": \"N\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Positive test. Uses a dynamic {{keyId}} generated in the pre-request script so re-running does not produce 409s."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Dynamic variable: unique Id per run.",
              "pm.environment.set('keyId', Math.floor(Math.random() * 1_000_000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Array with one item', () => pm.expect(body).to.be.an('array').with.lengthOf(1));",
              "pm.test('Keys generated', () => pm.expect(body[0].Keys).to.be.an('array').that.is.not.empty);",
              "// Chain: save the Id for the next request.",
              "pm.environment.set('lastKeyId', body[0].Id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Positive: GET /keys/{id} (chained)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/keys/{{lastKeyId}}",
          "host": ["{{baseUrl}}"],
          "path": ["keys", "{{lastKeyId}}"]
        },
        "description": "Chains from request 02 by using {{lastKeyId}}. Learn: request chaining."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Returned Id matches', () => pm.expect(body[0].Id).to.eql(Number(pm.environment.get('lastKeyId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Negative: POST /keys empty array",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "[]" },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Negative test: empty array should be rejected with 400 and the standard error envelope."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('Standard error envelope', () => {",
              "  pm.expect(body).to.have.property('error', true);",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body).to.have.property('status', 400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Negative: POST /keys invalid DataType",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": 999, \"Data\": \"Bad type\", \"DataType\": \"X\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Validation testing: invalid enum value → 422."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('Error message mentions validation', () => {",
              "  pm.expect(pm.response.json().message.toLowerCase()).to.include('validation');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Negative: POST /keys duplicate Ids in body",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": 700, \"Data\": \"A\", \"DataType\": \"N\" },\n  { \"Id\": 700, \"Data\": \"B\", \"DataType\": \"N\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Negative test: two records share the same Id → 400."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Message mentions duplicate', () => {",
              "  pm.expect(pm.response.json().message.toLowerCase()).to.include('duplicate');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Boundary: POST /keys 200-char Data",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": {{boundaryId}}, \"Data\": \"{{payload200}}\", \"DataType\": \"A\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Boundary testing: 200 characters is the maximum. 201 characters should fail."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('boundaryId', Math.floor(Math.random() * 1_000_000));",
              "pm.environment.set('payload200', 'X'.repeat(200));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 at max length', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Positive: POST /matchscore identical strings",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": {{matchId}}, \"Data1\": \"Bruce Wayne\", \"Data2\": \"Bruce Wayne\", \"DataType\": \"Name\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/matchscore", "host": ["{{baseUrl}}"], "path": ["matchscore"] },
        "description": "Positive test: identical inputs must score 100 and Decision 'A'."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('matchId', Math.floor(Math.random() * 1_000_000));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Score is 100', () => pm.expect(body[0].Score).to.eql(100));",
              "pm.test(\"Decision is 'A'\", () => pm.expect(body[0].Decision).to.eql('A'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Data-driven: POST /matchscore (Collection Runner)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": {{iterationId}}, \"Data1\": \"{{data1}}\", \"Data2\": \"{{data2}}\", \"DataType\": \"{{dataType}}\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/matchscore", "host": ["{{baseUrl}}"], "path": ["matchscore"] },
        "description": "Data-driven test. Run this request via Collection Runner with data-driven-matchscore.csv."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Ensure each CSV row gets a unique Id.",
              "pm.environment.set('iterationId', Number(pm.variables.get('iterationId') || Math.floor(Math.random() * 1_000_000)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json()[0];",
              "pm.test('Decision matches expected', () => {",
              "  pm.expect(body.Decision).to.eql(pm.variables.get('expectedDecision'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Positive: POST /ranges",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": {{rangeId}}, \"Data\": \"BRUCE WAYNE\", \"DataType\": \"N\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/ranges", "host": ["{{baseUrl}}"], "path": ["ranges"] },
        "description": "Positive test for POST /ranges."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('rangeId', Math.floor(Math.random() * 1_000_000));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Ranges present', () => pm.expect(body[0].Ranges).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Negative: GET /keys/{id} not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/keys/9999999",
          "host": ["{{baseUrl}}"],
          "path": ["keys", "9999999"]
        },
        "description": "Negative test: missing Id → 404 with standard envelope."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Envelope has error=true', () => pm.expect(pm.response.json().error).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Regression: POST twice → 409 Conflict",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"Id\": 88888, \"Data\": \"Regression subject\", \"DataType\": \"A\" }\n]"
        },
        "url": { "raw": "{{baseUrl}}/keys", "host": ["{{baseUrl}}"], "path": ["keys"] },
        "description": "Run this twice. Second run must return 409. Great for regression demos."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Status codes drill: GET /error/{code}",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/error/{{errorCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["error", "{{errorCode}}"]
        },
        "description": "Loop through 400/401/403/404/409/418/422/500/503 in the Collection Runner and assert status codes."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["if (!pm.environment.get('errorCode')) pm.environment.set('errorCode', 418);"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status matches requested code', () => {",
              "  pm.expect(pm.response.code).to.eql(Number(pm.environment.get('errorCode')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Bug hunt: POST /buggy/keys []",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "[]" },
        "url": { "raw": "{{baseUrl}}/buggy/keys", "host": ["{{baseUrl}}"], "path": ["buggy", "keys"] },
        "description": "Intentional bug: empty arrays are accepted. Compare with request 04. Write a test that FAILS to document the defect."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('EXPECTED FAILURE: empty array should be 400', () => {",
              "  pm.expect(pm.response.code, 'buggy endpoint accepts empty arrays').to.eql(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Admin: seed & reset",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/seed",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "seed"]
        },
        "description": "Preload sample data. Great as a Collection Runner set-up step."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ]
}
